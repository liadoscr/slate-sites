# Supabase: create a project, then copy these values from Project Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Used by Slate's backend when it creates a short-lived, one-time handoff.
SLATE_HANDOFF_HMAC_SECRET=

# Server-side application URL used for Slate handoffs. Use http://localhost:3000 locally.
SLATE_SITES_APP_URL=http://localhost:3000

# Gemini is server-only. Do not use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
# Optional: override the lightweight default model for testing.
GEMINI_MODEL=gemini-3.1-flash-lite
